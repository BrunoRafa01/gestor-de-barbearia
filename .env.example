# ---------------------------------------------------------------------------
# Gestor de Barbearia - Nova Runtime
# Copie este arquivo para ".env" e ajuste os valores antes de rodar o sistema.
# (O arquivo ".env" nao vai para o GitHub - veja .gitignore)
# ---------------------------------------------------------------------------

# -------------------------- Ambiente local (SQLite) ------------------------

# Porta HTTP do servidor local
PORT=3000

# Host (use 0.0.0.0 para acessar pelo celular na mesma rede Wi-Fi)
HOST=0.0.0.0

# Fuso horario da aplicacao (padrao Brasilia)
TZ=America/Sao_Paulo

# Senha inicial de acesso ao painel administrativo (opcional em desenvolvimento).
# Se omitida, uma senha provisoria aleatoria e exibida no terminal no primeiro boot.
# Em producao, defina uma senha forte (8+ chars, maiuscula, minuscula e numero):
# ADMIN_PASSWORD=DefinaUmaSenhaForte123

# Chave customizada para assinatura de sessao (opcional; se omitida, uma chave
# segura e gerada automaticamente e armazenada no banco)
# SESSION_SECRET=uma-chave-longa-e-aleatoria-com-mais-de-32-caracteres

# Caminho do arquivo do banco de dados SQLite (opcional)
# DATABASE_PATH=./data/barbearia.db

# --------------------------- Producao (Render) ------------------------------
# No Render NAO use SQLite: o disco do plano gratuito e efemero.
# Deixe as duas variaveis abaixo vazias no seu computador e preencha apenas
# no painel do Render (Environment), apos criar o banco gratuito no Turso.

# TURSO_DATABASE_URL=libsql://SEU-BANCO.turso.io
# TURSO_AUTH_TOKEN=cole-aqui-o-token-de-acesso-do-turso

# Defina como true apenas quando o servidor estiver atras de proxy reverso confiavel (ex.: Render)
# TRUST_PROXY=true

# Retencao de logs/mensagens em dias (scripts/retention-purge.mjs)
# LGPD_RETENTION_DAYS=180

# ------------------ WhatsApp Business Cloud API (Opcional) ------------------
# WHATSAPP_CLOUD_ENABLED=0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_ADMIN_PHONE=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# ------------------ Login com Google OAuth 2.0 (Opcional) -------------------
# Crie um ID do cliente OAuth 2.0 (Aplicativo Web) no Google Cloud Console com
# URI de redirecionamento: http://localhost:3000/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# Lista de e-mails autorizados a entrar via Google (separados por virgula)
# ADMIN_ALLOWED_EMAILS=admin@barbearia.com
# Defina como true para permitir que qualquer conta Google crie sua propria barbearia (SaaS aberto)
# OAUTH_ALLOW_SIGNUP=false
